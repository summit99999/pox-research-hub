# ==============================================================================
# POx Research Hub - Environment Variables Template
# Copy this file to .env in backend/ and frontend/ (with VITE_ prefix for frontend)
# NEVER commit real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Cloud PostgreSQL & Auth)
# Get these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Service role key is used exclusively by the backend for secure administrative actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# SCIENTIFIC LITERATURE APIS
# ------------------------------------------------------------------------------
# OpenAlex and Crossref provide higher rate limits when an email is supplied (Polite Pool)
OPENALEX_EMAIL=your-email@domain.com
CROSSREF_EMAIL=your-email@domain.com
# Semantic Scholar API Key (Optional, free from https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# BACKEND SERVER & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Secret token to protect the scheduled automated literature collection endpoint
CRON_SECRET=generate-a-secure-random-secret-for-cron-triggers

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Used in frontend/.env)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
VITE_API_BASE_URL=http://localhost:8000
